# Copy to .env.local and fill in. Never commit real keys.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Square (developer.squareup.com) - use sandbox while building
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_TERMINAL_DEVICE_ID=
# Online payments (Square hosted checkout). Also needs SUPABASE_SERVICE_ROLE_KEY.
# Webhook: Square dashboard > Webhooks > Subscriptions, event payment.updated,
# URL https://<your-site>/api/square/webhook; paste its signature key here.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Only if the site sits behind a proxy that changes the URL: the exact webhook URL saved in Square.
SQUARE_WEBHOOK_URL=

# Routing (Google Routes API or Mapbox)
MAPS_API_KEY=

# Email (Resend or Postmark)
EMAIL_API_KEY=
EMAIL_FROM=
